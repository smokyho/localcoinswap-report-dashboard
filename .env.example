# Copy to .env and fill in. Never commit .env.
#
# Create a key at https://localcoinswap.com/preferences/api-token
# (requires an authenticator code). Format: lcs_<prefix>_<secret>
LCS_API_KEY=

# Your LocalCoinSwap username. Used to tell a buy from a sell.
# Optional -- the app tries to auto-detect it from /referrals/overview/.
LCS_USERNAME=

# Reporting currency.
LCS_DISPLAY_CURRENCY=IDR

# Currency the LCS cryptoInUsd field is quoted in.
LCS_BASE_CURRENCY=USD

# Which calendar day a trade timestamp maps to. UTC by default.
# Trades near midnight can land on a different day, selecting a different rate.
LCS_TRADE_TIMEZONE=UTC

# Server bind address.
LCS_HOST=0.0.0.0
LCS_PORT=7010

# Pagination / pacing. The API allows 60 requests/minute/account.
LCS_PAGE_SIZE=200
LCS_MAX_TRADES=20000
LCS_MIN_INTERVAL=1.1
LCS_TIMEOUT=30
